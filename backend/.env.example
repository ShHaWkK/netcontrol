# Copier en backend/.env (déjà dans .gitignore — ne jamais committer le vrai fichier).
# Laisser vide = NetControl reste 100% simulé (comportement par défaut).

# Un ou plusieurs switchs réels, séparés par des virgules. Pour ajouter un
# switch : ajouter une entrée ici, rien d'autre à changer.
# Type Netmiko par défaut (utilisé si non précisé par switch) :
NETCONTROL_SWITCH_DEVICE_TYPE=cisco_ios
# Mêmes identifiants pour tout le parc (cas courant : admin local partagé) :
NETCONTROL_SWITCH_USER=admin
NETCONTROL_SWITCH_PASSWORD=
NETCONTROL_SWITCH_SECRET=
# "host" seul = utilise NETCONTROL_SWITCH_DEVICE_TYPE ci-dessus.
# "host:device_type" = force un type différent pour ce switch précis
# (parc mixte, ex: Cisco IOS + NX-OS + Aruba — types Netmiko supportés :
# https://github.com/ktbyers/netmiko/blob/develop/PLATFORMS.md) :
NETCONTROL_SWITCH_HOSTS=10.1.10.39
# ex. parc mixte : NETCONTROL_SWITCH_HOSTS=10.1.10.39,10.1.10.40:cisco_nxos,10.1.10.41:aruba_os

# Ports protégés en plus des trunks/uplinks (toujours protégés par défaut) :
NETCONTROL_SWITCH_EXTRA_PROTECTED_PORTS=

# Coupe-circuit : passer à false pour désactiver l'écriture réelle (apply)
# même si des switchs réels sont configurés ci-dessus.
NETCONTROL_SWITCH_WRITE_ENABLED=true

# Zabbix — alertes/problèmes réels (vide = alertes simulées).
# Privilégier un API token (Zabbix 7.0 : Administration > API tokens).
NETCONTROL_ZABBIX_URL=
NETCONTROL_ZABBIX_TOKEN=
# ...ou, à défaut de token, user/password :
NETCONTROL_ZABBIX_USER=
NETCONTROL_ZABBIX_PASSWORD=

# WLC WiFi (SNMP) — PAS ENCORE BRANCHÉ dans l'app (voir wlc_gateway.py),
# seulement testable via scripts/test_wlc_connectivity.py pour l'instant.
# Ce qu'il faut réunir auprès du réseau/sécurité, par WLC :
#  - IP de management du WLC
#  - Une communauté SNMP EN LECTURE SEULE (v2c) — pas un compte admin web
# Un ou plusieurs WLC, séparés par des virgules (même principe que les switchs) :
NETCONTROL_WLC_HOSTS=
NETCONTROL_WLC_SNMP_VERSION=2c
NETCONTROL_WLC_COMMUNITY=
# ...ou SNMPv3 (recommandé en prod) :
NETCONTROL_WLC_V3_USER=
NETCONTROL_WLC_V3_AUTH_PASSWORD=
NETCONTROL_WLC_V3_PRIV_PASSWORD=
